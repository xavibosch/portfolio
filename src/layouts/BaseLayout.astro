---
/* Every page of the site is this one document: the cardholder, and the folio
   that opens over it. A page built for a view (a project, the collection,
   About, Contact) arrives with the folio already written and open, so it
   reads in full without JavaScript and every link preview gets its own
   title, text and image. With JavaScript the folio starts closed and opens
   with its usual motion (see main.js). */
import '../foundation.css';
import '../wallet.css';
import '../folio.css';
import '../interaction.css';
import '../project-card.css';
import '../legibility.css';
import '../redesign.css';
import '../controls.css';
import '../dark.css';
import '../vito.css';
import '../a11y.css';
import '../noscript.css';
import '../product.css';
import { SITE } from '../site.js';
import projects from '../data/projects.json';
import { productView, modeSwitch } from '../product-view.js';
import { localizeProjects } from '../i18n.js';
localizeProjects(projects);

interface Props {
  title: string;
  description: string;
  path: string;
  image: string;
  view?: '' | 'index' | 'about' | 'contact' | 'work';
  panelHtml?: string;
  panelLabel?: string;
  heading?: string;
}
const { title, description, path, image, view = '', panelHtml = '', panelLabel = 'SELECTED WORK', heading = '' } = Astro.props;
const url = `${SITE}${path}`;
const imageUrl = `${SITE}${image}`;
const open = Boolean(panelHtml);
const product = productView(projects, { cv: '/Xavi-Bosch-CV-EN.pdf', heading: !panelHtml });
const current = (link: string) => (link === view || (view === 'work' && link === 'index') ? 'page' : undefined);
---
<!doctype html>
<html lang="en" data-mode="product">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eeede9" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content={view === 'work' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Xavier Bosch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Links shared before the site had real addresses (#/work/betsy) are
         moved onto the real one before anything runs, without a reload. -->
    <script is:inline>
      (function () {
        var hash = location.hash;
        if (hash.indexOf('#/') === 0) {
          var view = hash.slice(2).replace(/\/+$/, '');
          history.replaceState(null, '', !view ? '/' : view === 'index' ? '/work' : '/' + view);
        }
        document.documentElement.classList.add('js');
        // Product (the page to scan) unless this visitor chose the cardholder.
        var mode = null;
        try { mode = localStorage.getItem('mode'); } catch (e) {}
        document.documentElement.dataset.mode = mode === 'creative' ? 'creative' : 'product';
      })();
    </script>
    <style is:inline>html.js .panel[data-ssr]{visibility:hidden}</style>
    <link rel="icon" href="/icons/xb.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/xb-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icons/xb-16.png" type="image/png" sizes="16x16" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/xb-apple-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/brushed-metal.webp" as="image" />
  </head>
  <body class="wallet-portfolio">
    <div id="product" class="pm"><a class="skip-link" href="#pm-work" data-i18n="skip">Skip to the selected case study</a><Fragment set:html={product} /></div>
    <div id="app"><a class="skip-link" href="#open-project" data-i18n="skip">Skip to the selected case study</a>
      <header class="header">
        <a class="identity" href="/" aria-label="Xavier Bosch home" data-i18n-attr="aria-label:identity"><span class="monogram" aria-hidden="true">xb<span>®</span></span><span class="identity-caption">XAVIER BOSCH<br />DESIGN + CODE</span></a>
        <nav class="navigation" aria-label="Main navigation" data-i18n-attr="aria-label:nav.main"><button id="index-button"><span data-i18n="nav.collection">The collection</span> <sup>11</sup></button><button id="about-button" data-i18n="nav.about">About me</button><button id="contact-button"><span data-i18n="nav.contact">Get in touch</span> <span aria-hidden="true"><i data-icon="arrow-up-right"></i></span></button></nav>
        <span class="lang-slot header-lang" data-lang-slot="phone"></span>
        <div class="location"><span id="local-time"></span> BARCELONA<span class="lang-slot" data-lang-slot="header"></span><button id="theme-button" class="theme-button" aria-pressed="false" aria-label="Switch to dark mode"><span id="theme-label" aria-hidden="true"><i data-icon="theme"></i></span></button></div>
        <span class="header-mode"><Fragment set:html={modeSwitch('holder-switch')} /></span>
      </header>

      <main class="studio" id="studio"><span class="lang-slot studio-lang" data-lang-slot="studio"></span>
        <div class="studio-note"><span class="eyebrow" data-i18n="home.eyebrow">XAVIER BOSCH · INTERACTIVE PRODUCT DESIGNER &amp; DEVELOPER</span><p class="positioning" role="heading" aria-level="1" data-i18n-html="home.positioning">I design the interface,<br />question the interaction<br />and build the working product.</p></div>
        <div class="availability"><span><b class="availability-title" data-i18n="home.available">OPEN TO INTERNSHIPS · SUMMER 2027</b><br /><span data-i18n="home.availableDetail">Product design, UX engineering, frontend or interaction design. Barcelona or abroad.</span></span></div>
        <div class="wallet-scene" id="scene" data-i18n-attr="aria-label:home.scene" aria-label="A silver cardholder with five cards: about me, three case studies and contact. Choose a card to open it."></div>
        <p class="pick-hint"><span data-i18n="home.pick">Pick a card to open it.</span><svg width="49" height="39" viewBox="0 0 49 39" aria-hidden="true"><path d="M3 3C1 24 23 32 43 26M35 20l9 6-7 9" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></p>
        <div class="selected-project" aria-live="polite" aria-atomic="true"><div class="selection-index"><span id="project-number">01</span><span>/ 03</span></div><div class="caption-copy"><span id="current-context">PERSONAL PRODUCT</span><h2 id="project-title">Jeffrey Desk</h2><p id="project-summary">A personal workspace, turned into a product.</p><span id="current-role" class="sr-only"></span></div><button id="open-project" class="card-open" aria-label="Open Jeffrey Desk case study"><span data-i18n="home.open">Open case study</span><span aria-hidden="true"><i data-icon="arrow-up-right"></i></span></button></div>
      </main>

      <footer class="footer">
        <button class="archive-button" id="archive-button"><span class="grid-icon" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span data-i18n="home.collection">THE COLLECTION · ALL 11 PROJECTS</span></button>
        <div class="transport"><button id="prev-project" class="arrow-button" aria-label="Previous project" data-i18n-attr="aria-label:home.prev"><i data-icon="arrow-left"></i></button><div class="featured-picker" id="featured-picker" role="group" aria-label="Selected case studies" data-i18n-attr="aria-label:home.picker"></div><button id="next-project" class="arrow-button" aria-label="Next project" data-i18n-attr="aria-label:home.next"><i data-icon="arrow-right"></i></button><span class="transport-hint" data-i18n="home.hint">ARROWS OR SCROLL SWITCH CARDS · SPACE OPENS</span></div>
        <a class="footer-cv" href="/Xavi-Bosch-CV-EN.pdf" download><span data-i18n="home.cv">DOWNLOAD CV</span> <i data-icon="arrow-down"></i></a>
      </footer>
    </div>
    <section class="home-more" id="home-more" aria-label="Selected case studies and contact" data-i18n-attr="aria-label:home.more"></section>
    <dialog id="panel" class="panel" aria-label="Portfolio card" data-i18n-attr="aria-label:panel.label" open={open || undefined} data-ssr={open ? '' : undefined} data-view={view || undefined}><div class="panel-shell metal-surface" data-reflect tabindex="-1"><div class="panel-top"><a class="panel-home" href="/" aria-label="Back to the cardholder" data-i18n-attr="aria-label:panel.home"><span class="folio-mark">xb.</span><span><span data-i18n="panel.collection">PERSONAL COLLECTION</span><br /><span class="panel-label" id="panel-label">{panelLabel}</span></span></a><nav class="panel-nav" aria-label="Inside the cardholder" data-i18n-attr="aria-label:panel.nav"><a href="/work" data-view="index" data-i18n="panel.navCollection" aria-current={current('index')}>Collection</a><a href="/about" data-view="about" data-i18n="panel.navAbout" aria-current={current('about')}>About me</a><a href="/contact" data-view="contact" data-i18n="panel.navContact" aria-current={current('contact')}>Contact</a></nav><div class="panel-actions"><span class="lang-slot panel-lang" data-lang-slot="panel"></span><button class="close-panel" id="close-panel" aria-label="Close panel" data-i18n-attr="aria-label:panel.closeLabel"><span data-i18n="panel.close">Put back</span><span class="close-symbol" aria-hidden="true"><i data-icon="close"></i></span></button><noscript><a class="close-panel noscript-close" href="/"><span>Put back</span></a></noscript></div></div>{open ? <h1 class="sr-only" id="panel-title">{heading}</h1> : <h2 class="sr-only" id="panel-title"></h2>}<div id="panel-content" class="panel-content"><Fragment set:html={panelHtml} /></div><div class="folio-rim"><span aria-hidden="true" data-i18n="panel.rim">XAVIER BOSCH / DESIGN + CODE</span><span aria-hidden="true">XB—001</span></div></div></dialog>
    <div class="toast" id="toast" role="status"></div>
    <script>import '../main.js';</script>
  </body>
</html>
